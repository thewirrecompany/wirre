{
  "buildCommand": "npm run build:prod",
  "outputDirectory": "dist",
  "framework": "vite",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "dev": false
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "wirre.vercel.app"
        }
      ],
      "destination": "https://wirre.in/$1",
      "permanent": true
    }
  ],
  "routes": [
    {
      "src": "/supabase-proxy/(.*)",
      "dest": "https://iaqzckrdoovxtmjinxal.supabase.co/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}