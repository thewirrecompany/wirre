{
  "buildCommand": "npm run build:prod",
  "outputDirectory": "dist",
  "framework": "vite",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "dev": false
    }
  },
  "routes": [
    {
      "src": "/supabase-proxy/(.*)",
      "dest": "https://iaqzckrdoovxtmjinxal.supabase.co/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}