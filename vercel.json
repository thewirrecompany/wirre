{
  "buildCommand": "npm run build:prod",
  "outputDirectory": "dist",
  "framework": "vite",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "dev": false
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "wirre.vercel.app"
        }
      ],
      "destination": "https://wirre.in/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/supabase-proxy/:path*",
      "destination": "https://<YOUR_SUPABASE_PROJECT_ID>.supabase.co/:path*"
    },
    {
      "source": "/((?!_vercel/).*)",
      "destination": "/index.html"
    }
  ]
}