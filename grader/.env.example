# Groq API Key — get yours at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Supabase credentials (same as your root .env)
SUPABASE_URL=https://***REMOVED***.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# GitHub App credentials (for fetching diffs from private repos)
GITHUB_APP_ID=your_github_app_id
GITHUB_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GITHUB_INSTALLATION_ID=your_installation_id
GITHUB_ORG=wirrecompany

# Groq model to use (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile
